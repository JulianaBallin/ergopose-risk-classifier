      "source": [
        "# === Reprodutibilidade e checkpointing ===\n",
        "import os, time, hashlib, json, csv, random\n",
        "from pathlib import Path\n",
        "import joblib\n",
        "import numpy as np\n",
        "import torch\n",
        "\n",
        "def set_seed(seed:int):\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "    torch.cuda.manual_seed_all(seed)\n",
        "    torch.backends.cudnn.deterministic=True\n",
        "    torch.backends.cudnn.benchmark=False\n",
        "    print(f\"[seed] {seed}\")\n",
        "\n",
        "def file_sha256(path:str, block_size=65536):\n",
        "    h=hashlib.sha256()\n",
        "    with open(path,'rb') as f:\n",
        "        for blk in iter(lambda: f.read(block_size), b''):\n",
        "            h.update(blk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "def save_checkpoint(model, optimizer, epoch, seed, metrics, path, extra=None):\n",
        "    path=Path(path)\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    ckpt={\n",
        "      'model_state_dict': model.state_dict(),\n",
        "      'optimizer_state_dict': optimizer.state_dict() if optimizer else None,\n",
        "      'epoch': epoch,\n",
        "      'seed': seed,\n",
        "      'metrics': metrics,\n",
        "      'timestamp': time.strftime('%Y-%m-%d %H:%M:%S')\n",
        "    }\n",
        "    if extra: ckpt['extra']=extra\n",
        "    torch.save(ckpt, str(path))\n",
        "    print('[checkpoint salvo]', path)\n",
        "\n",
        "def save_artifacts(scaler, encoder, prefix):\n",
        "    Path(prefix).parent.mkdir(parents=True, exist_ok=True)\n",
        "    joblib.dump(scaler, f\"{prefix}_scaler.joblib\")\n",
        "    joblib.dump(encoder, f\"{prefix}_labelencoder.joblib\")\n",
        "    print('[artifacts salvos]', prefix)\n",
        "\n",
        "def append_experiment_log(csv_path, row:dict):\n",
        "    csv_path=Path(csv_path)\n",
        "    exists=csv_path.exists()\n",
        "    with open(csv_path,'a',newline='') as f:\n",
        "        w=csv.DictWriter(f, fieldnames=list(row.keys()))\n",
        "        if not exists: w.writeheader()\n",
        "        w.writerow(row)\n",
        "    print('[log registrado]', csv_path)\n"
      ],
      "execution_count": 3,
